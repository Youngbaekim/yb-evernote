rules_version = '2';
// YB-EverNote 보안 규칙 — 가족 각자 개인 노트
// 허용 목록(ALLOWED)에 있는 Google 계정만 로그인해 쓸 수 있고, 각자 자기 공간(users/{uid})만 읽고 쓸 수 있음
// 가족을 추가·제외하려면 아래 목록만 고친 뒤 콘솔 '규칙' 탭에 다시 게시
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'youngpeace@gmail.com'
          // , 'family1@gmail.com'
          // , 'family2@gmail.com'
        ];
    }
    match /users/{uid}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
  }
}
