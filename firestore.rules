rules_version = '2';
// YB-EverNote 보안 규칙 — 가족 각자 개인 노트
// 허용 목록(ALLOWED)에 있는 Google 계정만 로그인해 쓸 수 있고, 각자 자기 공간(users/{uid})만 읽고 쓸 수 있음
// 가족을 추가·제외하려면 아래 목록만 고친 뒤 콘솔 '규칙' 탭에 다시 게시
service cloud.firestore {
  match /databases/{database}/documents {
    function allowed() {
      return request.auth != null
        && request.auth.token.email_verified == true
        && request.auth.token.email in [
          'youngpeace@gmail.com',        // 본인
          'jhyang80@gmail.com',          // 가족
          'eunice.yuha@gmail.com',       // 가족
          'lydiaminha1124@gmail.com'     // 가족
        ];
    }
    match /users/{uid}/{document=**} {
      allow read, write: if allowed() && request.auth.uid == uid;
    }
    // YB Family Food Diary (2026.11) — 가족 공용 식사 일기
    // - 허용 목록 가족은 모두 읽기 가능
    // - 문서 ID가 '날짜_끼니'라서 같은 끼니는 1건만, 남이 올린 끼니는 덮어쓸 수 없음
    // - 수정·삭제는 올린 사람(owner)만
    match /family/{fam}/{kind}/{id} {
      allow read: if allowed() && kind in ['meals', 'mealImages'];
      allow create: if allowed() && kind in ['meals', 'mealImages']
        && request.resource.data.owner == request.auth.uid;
      allow update: if allowed() && kind in ['meals', 'mealImages']
        && resource.data.owner == request.auth.uid
        && request.resource.data.owner == request.auth.uid;
      allow delete: if allowed() && kind in ['meals', 'mealImages']
        && (resource == null || resource.data.owner == request.auth.uid);
    }
    // 웹에 게시한 노트의 공개 사본 (v0.8.0)
    // - 주소(공유 ID)를 아는 사람은 로그인 없이 읽기만 가능, 목록 조회(전체 게시물 훑기)는 막음
    // - 쓰기는 게시한 본인만
    match /public/{shareId} {
      allow get: if true;
      allow list: if false;
      allow create: if allowed() && request.resource.data.owner == request.auth.uid;
      allow update: if allowed() && resource.data.owner == request.auth.uid && request.resource.data.owner == request.auth.uid;
      allow delete: if allowed() && resource.data.owner == request.auth.uid;
      match /{sub=**} {
        allow read: if true;
        allow write: if allowed() && get(/databases/$(database)/documents/public/$(shareId)).data.owner == request.auth.uid;
      }
    }
  }
}
